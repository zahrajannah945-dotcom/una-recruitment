:root{
  --primary:#2563EB;
  --primary-dark:#1E3A8A;
  --primary-500:#3B82F6;
  --primary-light:#DBEAFE;
  --soft-blue:#EFF6FF;

  --white:#FFFFFF;
  --surface:#F8FAFC;
  --border:#E2E8F0;
  --text-primary:#0F172A;
  --text-secondary:#64748B;
  --text-dark:#334155;

  --success:#16A34A;
  --success-bg:#DCFCE7;
  --warning:#D97706;
  --warning-bg:#FEF3C7;
  --error:#DC2626;
  --error-bg:#FEE2E2;

  --radius-small:8px;
  --radius-card:12px;
  --radius-large:16px;
  --radius-pill:999px;

  --shadow-card:0 1px 3px rgba(15, 23, 42, 0.08);
  --shadow-elevated:0 4px 12px rgba(15, 23, 42, 0.08);
  --shadow-modal:0 12px 32px rgba(15, 23, 42, 0.15);

  --spacing-4:4px;
  --spacing-8:8px;
  --spacing-12:12px;
  --spacing-16:16px;
  --spacing-24:24px;
  --spacing-32:32px;
  --spacing-48:48px;
  --spacing-64:64px;
  --spacing-80:80px;
  --spacing-96:96px;
}

*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color:var(--text-primary);
  background:var(--white);
}

a{ color:inherit; text-decoration:none; }
img{ max-width:100%; height:auto; display:block; }

:focus-visible{
  outline:3px solid var(--primary-500);
  outline-offset:3px;
  border-radius:8px;
}

.sr-only{
  position:absolute;
  width:1px;height:1px;
  padding:0;margin:-1px;
  overflow:hidden;clip:rect(0,0,0,0);
  white-space:nowrap;border:0;
}

/* Layout */
.container{
  width:100%;
  max-width:1200px;
  margin:0 auto;
  padding:0 var(--spacing-24);
}
.section{
  padding: var(--spacing-64) 0;
}
.section--tight{ padding: var(--spacing-48) 0; }
.section--bg{
  background:var(--surface);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}
.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:var(--spacing-32);
}
.grid-3{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:var(--spacing-24);
}
.grid-4{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:var(--spacing-24);
}

/* Typography */
.display{
  font-size:48px;
  line-height:56px;
  font-weight:650;
  margin:0;
  letter-spacing:-0.02em;
}
.h1{
  font-size:40px;
  line-height:48px;
  font-weight:650;
  margin:0;
}
.h2{
  font-size:32px;
  line-height:40px;
  font-weight:650;
  margin:0;
}
.h3{
  font-size:24px;
  line-height:32px;
  font-weight:600;
  margin:0;
}
.h4{
  font-size:20px;
  line-height:28px;
  font-weight:600;
  margin:0;
}
.body{
  font-size:16px;
  line-height:24px;
  margin:0;
  color:var(--text-dark);
}
.body-lg{
  font-size:18px;
  line-height:28px;
  margin:0;
  color:var(--text-dark);
}
.caption{
  font-size:12px;
  line-height:16px;
  color:var(--text-secondary);
  margin:0;
}

/* Navbar */
.navbar{
  position:sticky;
  top:0;
  z-index:40;
  background:rgba(255,255,255,0.85);
  backdrop-filter:saturate(180%) blur(10px);
  border-bottom:1px solid var(--border);
}
.navbar__inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 0;
}
.brand{
  display:flex;
  align-items:center;
  gap:12px;
}
.brand img{
  width:44px;
  height:auto;
}
.brand__text{
  font-weight:700;
  letter-spacing:-0.01em;
}
.nav__links{
  display:flex;
  gap:24px;
  align-items:center;
}
.nav__links a{
  color:var(--text-secondary);
  font-size:14px;
  line-height:20px;
  font-weight:550;
}
.nav__links a:hover{
  color:var(--text-primary);
}
.nav__cta{
  margin-left:8px;
}

/* Hero */
.hero{
  padding: var(--spacing-96) 0 var(--spacing-64);
  position:relative;
  overflow:hidden;
}
.hero__wrap{
  display:flex;
  align-items:stretch;
  gap:var(--spacing-32);
}
.hero__left{
  flex: 1.2;
  padding-top: var(--spacing-32);
}
.hero__label{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-weight:700;
  font-size:14px;
  line-height:20px;
  color:var(--primary-dark);
  background:rgba(219,234,254,0.7);
  border:1px solid rgba(219,234,254,0.9);
  padding:8px 12px;
  border-radius:var(--radius-pill);
}
.hero__title{
  margin-top:var(--spacing-16);
}
.hero__sub{
  margin-top:var(--spacing-24);
  max-width:560px;
  color:var(--text-dark);
  font-size:18px;
  line-height:28px;
}
.hero__cta{
  margin-top:var(--spacing-24);
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}
.hero__right{
  flex: 0.8;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  position:relative;
}
.hero__shape{
  width:100%;
  max-width:420px;
  aspect-ratio: 1/1;
  border-radius:24px;
  background:
    radial-gradient(1200px 500px at 20% 20%, rgba(37,99,235,0.15), rgba(37,99,235,0) 60%),
    linear-gradient(135deg, rgba(219,234,254,0.75), rgba(248,250,252,0.9));
  border:1px solid rgba(226,232,240,0.9);
  box-shadow: var(--shadow-card);
  position:relative;
  overflow:hidden;
}
.hero__shape::before{
  content:"";
  position:absolute;
  inset:-40%;
  background:
    radial-gradient(circle at 30% 30%, rgba(37,99,235,0.25), transparent 45%),
    radial-gradient(circle at 70% 60%, rgba(59,130,246,0.18), transparent 48%);
  transform:rotate(10deg);
}
.hero__shape::after{
  content:"";
  position:absolute;
  left:18%;
  top:18%;
  width:64%;
  height:64%;
  border-radius:16px;
  border:2px solid rgba(37,99,235,0.18);
  background:rgba(255,255,255,0.55);
  backdrop-filter: blur(6px);
}

/* Buttons */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  height:48px;
  padding:0 24px;
  border-radius:8px;
  font-weight:650;
  font-size:16px;
  border:1px solid transparent;
  cursor:pointer;
  transition: transform .12s ease, background .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease;
}
.btn:active{ transform:translateY(1px); }
.btn-primary{
  background:var(--primary);
  color:var(--white);
  box-shadow: 0 4px 12px rgba(37,99,235,0.25);
}
.btn-primary:hover{ background: #1E40AF; }
.btn-secondary{
  background:rgba(239,246,255,1);
  color:var(--primary-dark);
  border-color:rgba(219,234,254,0.9);
}
.btn-secondary:hover{ background: rgba(219,234,254,1); }
.btn-outline{
  background:transparent;
  color:var(--primary-dark);
  border-color: var(--border);
}
.btn-outline:hover{
  border-color: rgba(37,99,235,0.35);
  background:var(--soft-blue);
}
.btn-ghost{
  background:transparent;
  color:var(--primary-dark);
  border-color: transparent;
  padding:0 14px;
  height:40px;
  font-size:14px;
  font-weight:650;
}
.btn-ghost:hover{
  background: rgba(248,250,252,1);
  border-color: var(--border);
}
.btn-danger{
  background:var(--error);
  color:var(--white);
  border-color:rgba(220,38,38,0.2);
}
.btn-danger:hover{ background:#B91C1C; }
.btn-disabled, .btn:disabled{
  opacity:0.6;
  cursor:not-allowed;
  box-shadow:none;
}

/* Cards & UI elements */
.card{
  background:var(--white);
  border:1px solid var(--border);
  border-radius:12px;
  box-shadow: var(--shadow-card);
}
.card-pad{ padding:24px; }
.card-title{ margin:0 0 12px; font-size:18px; line-height:28px; font-weight:700; color:var(--text-primary); }
.muted{ color:var(--text-secondary); }

.badge{
  display:inline-flex;
  align-items:center;
  padding:6px 12px;
  border-radius:var(--radius-pill);
  font-size:12px;
  font-weight:750;
  letter-spacing:0.01em;
  border:1px solid transparent;
}
.badge--pending{ background:var(--warning-bg); color: #92400E; border-color: rgba(217,119,6,0.2); }
.badge--interview{ background:var(--soft-blue); color: var(--primary-dark); border-color: rgba(37,99,235,0.2); }
.badge--accepted{ background:var(--success-bg); color: var(--success); border-color: rgba(22,163,74,0.2); }
.badge--rejected{ background:var(--error-bg); color: var(--error); border-color: rgba(220,38,38,0.2); }

/* Lists / checklist */
.checklist{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px 18px;
}
.check-item{
  display:flex;
  align-items:flex-start;
  gap:10px;
  padding:12px 14px;
  border-radius:12px;
  border:1px solid var(--border);
  background: #fff;
}
.check-icon{
  width:22px;height:22px;
  border-radius:999px;
  background: rgba(37,99,235,0.10);
  border:1px solid rgba(37,99,235,0.20);
  display:flex;align-items:center;justify-content:center;
  color:var(--primary-dark);
  font-weight:900;
  flex:0 0 auto;
}
.check-text{ font-size:14px; line-height:20px; font-weight:600; color:var(--text-dark); }

/* Divisions */
.division-card{
  padding:20px;
  border-radius:12px;
  border:1px solid var(--border);
  background:#fff;
  transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
}
.division-card:hover{
  transform: translateY(-3px);
  box-shadow: var(--shadow-elevated);
  border-color: rgba(37,99,235,0.25);
}
.division-icon{
  width:44px;height:44px;
  border-radius:12px;
  background: rgba(219,234,254,0.7);
  border:1px solid rgba(219,234,254,0.95);
  display:flex;align-items:center;justify-content:center;
  color:var(--primary-dark);
  font-size:18px;
  font-weight:900;
}
.division-card h3{ margin:12px 0 8px; font-size:16px; line-height:24px; }
.division-card p{ margin:0; font-size:14px; line-height:20px; color:var(--text-secondary); }

/* Timeline */
.timeline{
  display:flex;
  gap:16px;
  align-items:flex-start;
  justify-content:space-between;
}
.t-step{
  flex:1;
  text-align:center;
  position:relative;
  padding:12px 0;
}
.t-step:not(:last-child)::after{
  content:"";
  position:absolute;
  right:-8px;
  top:28px;
  width:16px;
  height:2px;
  background: rgba(226,232,240,1);
}
.t-marker{
  width:22px;height:22px;
  border-radius:999px;
  margin:0 auto 12px;
  border:2px solid #E2E8F0;
  background:#fff;
}
.t-step--done .t-marker{
  border-color: rgba(37,99,235,0.4);
  background: rgba(37,99,235,0.12);
}
.t-step--current .t-marker{
  border-color: rgba(37,99,235,1);
  background: rgba(37,99,235,1);
}
.t-step h4{ margin:0; font-size:14px; line-height:20px; color:var(--text-primary); font-weight:800; }
.t-step p{ margin:8px 0 0; font-size:12px; line-height:16px; color:var(--text-secondary); }
.t-step--done p, .t-step--current p{ color:var(--text-dark); }

/* FAQ */
.faq-list{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}
.faq-item{
  padding:16px 18px;
  border-radius:12px;
  border:1px solid var(--border);
  background:#fff;
  box-shadow: var(--shadow-card);
}
.faq-item summary{
  cursor:pointer;
  font-weight:800;
  color:var(--text-primary);
}
.faq-item summary::marker{
  color: var(--primary-500);
}
.faq-item p{
  margin:10px 0 0;
  color:var(--text-dark);
  font-size:14px;
  line-height:20px;
}

/* Forms */
.page-header{
  padding:56px 0 24px;
  border-bottom:1px solid var(--border);
  background: var(--surface);
}
.form-shell{
  padding:64px 0;
}
.form-card{
  max-width:740px;
  margin:0 auto;
  padding:24px;
}
.form-grid{
  display:grid;
  grid-template-columns: 1fr;
  gap:24px;
}
.form-title{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
}
.back-link{
  color:var(--primary-500);
  font-weight:800;
  font-size:14px;
}
.back-link:hover{ text-decoration:underline; }

fieldset{
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px 18px 16px;
}
legend{
  padding:0 10px;
  font-weight:900;
  color:var(--text-primary);
}
.form-help{
  margin:6px 0 0;
  color:var(--text-secondary);
  font-size:14px;
  line-height:20px;
}

.form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}
.label{
  display:block;
  font-weight:750;
  font-size:14px;
  line-height:20px;
  margin:14px 0 8px;
}
.input, select, textarea{
  width:100%;
  border:1px solid var(--border);
  border-radius:8px;
  height:44px;
  padding: 10px 14px;
  font-size:16px;
  color:var(--text-primary);
  background:#fff;
  transition: border-color .12s ease, box-shadow .12s ease;
}
textarea{
  height:auto;
  min-height:140px;
  padding:12px 14px;
  resize:vertical;
}
.input:focus, select:focus, textarea:focus{
  border-color: rgba(59,130,246,0.7);
  box-shadow: 0 0 0 4px rgba(59,130,246,0.15);
  outline:none;
}
.req{
  color:var(--primary-500);
  font-weight:900;
}
.helper{
  font-size:12px;
  color:var(--text-secondary);
  line-height:16px;
  margin-top:8px;
}
.charcount{
  display:flex;
  justify-content:flex-end;
  margin-top:8px;
  font-size:12px;
  color:var(--text-secondary);
}

.file{
  border:1px dashed rgba(226,232,240,1);
  background: #fff;
  border-radius:12px;
  padding:18px;
}
.file input[type="file"]{
  border:none;
  height:auto;
  padding:0;
}
.file .file-text{
  display:flex;
  gap:12px;
  align-items:flex-start;
  color:var(--text-secondary);
  font-size:14px;
  line-height:20px;
}
.file .file-text strong{ color:var(--text-primary); }
.file .file-hint{
  margin-top:8px;
  color:var(--text-secondary);
  font-size:12px;
  line-height:16px;
}

.checkbox{
  display:flex;
  gap:12px;
  align-items:flex-start;
  margin:14px 0;
}
.checkbox input{
  width:18px;height:18px;
  margin-top:3px;
}
.checkbox label{
  margin:0;
  font-weight:600;
  font-size:14px;
  line-height:20px;
  color:var(--text-dark);
}

.form-actions{
  display:flex;
  gap:12px;
  justify-content:center;
  margin-top:24px;
}

/* Table & dashboard */
.app-shell{
  padding:40px 0 64px;
}
.admin-layout{
  display:grid;
  grid-template-columns: 240px 1fr;
  gap:24px;
  align-items:start;
}
.sidebar{
  position:sticky;
  top:86px;
  align-self:start;
  border:1px solid var(--border);
  border-radius:16px;
  background: #fff;
  box-shadow: var(--shadow-card);
  padding:18px;
}
.sidebar-brand{
  display:flex;align-items:center;gap:12px;
  margin-bottom:16px;
}
.sidebar-brand img{ width:42px; }
.sidebar-nav{
  display:flex;
  flex-direction:column;
  gap:8px;
}
.sidebar-link{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 12px;
  border-radius:12px;
  border:1px solid transparent;
  color:var(--text-dark);
  font-weight:750;
  font-size:14px;
}
.sidebar-link:hover{
  background: var(--soft-blue);
  border-color: rgba(219,234,254,0.8);
}
.sidebar-link--active{
  background: rgba(219,234,254,0.9);
  border-color: rgba(37,99,235,0.25);
  color:var(--primary-dark);
}
.main{
  border:1px solid var(--border);
  border-radius:16px;
  background:#fff;
  box-shadow: var(--shadow-card);
  padding:24px;
}
.main h1{
  margin:0 0 10px;
  font-size:28px;
  line-height:36px;
}
.main-sub{
  margin:0 0 24px;
  color:var(--text-secondary);
  font-size:14px;
}
.stats{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:16px;
  margin-bottom:24px;
}
.stat-card{
  border:1px solid var(--border);
  border-radius:12px;
  padding:18px;
  background:#fff;
}
.stat-card .num{
  font-size:32px;
  line-height:40px;
  font-weight:900;
  color:var(--primary-dark);
}
.stat-card .lbl{
  font-size:14px;
  color:var(--text-secondary);
  font-weight:750;
}
.stat-card .hint{
  margin-top:8px;
  font-size:12px;
  color:var(--text-secondary);
}

.toolbar{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  align-items:center;
  margin:8px 0 16px;
}
.toolbar .search{
  flex:1;
  min-width:220px;
}
.table-wrap{
  overflow:auto;
  border:1px solid var(--border);
  border-radius:12px;
}
table{
  width:100%;
  border-collapse:collapse;
  min-width:720px;
}
th,td{
  padding:14px 14px;
  border-bottom:1px solid var(--border);
  text-align:left;
  font-size:14px;
  line-height:20px;
}
th{
  background: var(--surface);
  color:var(--text-secondary);
  font-size:12px;
  font-weight:900;
  letter-spacing:0.02em;
  text-transform:uppercase;
}
tbody tr:hover{
  background: rgba(239,246,255,1);
}
.actions-cell a{
  color:var(--primary-500);
  font-weight:850;
}
.actions-cell a:hover{ text-decoration:underline; }

/* Empty / Error / Offline */
.notice{
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px 18px;
  background:#fff;
}
.notice--info{
  border-color: rgba(37,99,235,0.2);
  background: rgba(239,246,255,0.8);
}
.notice--warning{
  border-color: rgba(217,119,6,0.25);
  background: rgba(254,243,199,0.85);
}
.notice--error{
  border-color: rgba(220,38,38,0.25);
  background: rgba(254,226,226,0.85);
}
.notice h3{ margin:0 0 8px; font-size:18px; line-height:24px; }
.notice p{ margin:0; color:var(--text-dark); font-size:14px; line-height:20px; }

/* Success card */
.success-hero{
  padding:80px 0 64px;
}
.success-box{
  max-width:720px;
  margin:0 auto;
  border-radius:16px;
  border:1px solid rgba(22,163,74,0.25);
  background: rgba(220,252,231,0.55);
  box-shadow: var(--shadow-card);
  padding:24px;
}
.success-top{
  display:flex; align-items:flex-start; gap:16px;
}
.success-icon{
  width:48px;height:48px;
  border-radius:16px;
  background: rgba(22,163,74,0.12);
  border:1px solid rgba(22,163,74,0.25);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;
  font-weight:900;
  color:var(--success);
}
.success-box h1{
  margin:0;
  font-size:28px;
  line-height:36px;
}
.success-box p{
  margin:10px 0 0;
  color:var(--text-dark);
  font-size:16px;
  line-height:24px;
}
.success-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:18px;
}

/* Footer */
.footer{
  padding:40px 0;
  border-top:1px solid var(--border);
  background:var(--surface);
}
.footer-inner{
  display:grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap:24px;
}
.footer h4{
  margin:0 0 10px;
  font-size:14px;
  text-transform:uppercase;
  color:var(--text-secondary);
  letter-spacing:0.04em;
}
.footer p, .footer a, .footer li{
  font-size:14px;
  line-height:20px;
  color:var(--text-dark);
}
.footer ul{
  list-style:none;
  padding:0;margin:0;
}
.footer li{ margin:10px 0; }
.footer-bottom{
  margin-top:28px;
  padding-top:18px;
  border-top:1px solid var(--border);
  color:var(--text-secondary);
  font-size:12px;
}

/* Responsive */
@media (max-width: 1023px){
  .hero__wrap{ flex-direction:column; }
  .hero__right{ justify-content:flex-start; }
  .grid-4{ grid-template-columns: repeat(2, 1fr); }
  .grid-3{ grid-template-columns: 1fr; }
  .timeline{ flex-direction:column; }
  .timeline .t-step{ text-align:left; }
  .timeline .t-step:not(:last-child)::after{
    content:none;
  }
  .faq-list{ grid-template-columns: 1fr; }
  .checklist{ grid-template-columns: 1fr; }
  .admin-layout{ grid-template-columns: 1fr; }
  .sidebar{ position:relative; top:auto; }
  .stats{ grid-template-columns: 1fr 1fr; }
}
@media (max-width: 767px){
  .container{ padding: 0 16px; }
  .hero{ padding: 64px 0 48px; }
  .display{ font-size:36px; line-height:44px; }
  .h1{ font-size:32px; line-height:40px; }
  .h2{ font-size:28px; line-height:36px; }
  .grid-2{ grid-template-columns:1fr; }
  .grid-4{ grid-template-columns:1fr; }
  .stats{ grid-template-columns: 1fr 1fr; }
  .form-row{ grid-template-columns: 1fr; }
  .footer-inner{ grid-template-columns:1fr; }
  table{ min-width: 520px; }
}
@media (prefers-reduced-motion: reduce){
  *{ transition:none !important; scroll-behavior:auto !important; }
}